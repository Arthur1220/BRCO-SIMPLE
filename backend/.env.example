# Banco SQLite. No Docker é sobrescrito para file:/app/data/brco.db (volume persistente).
DATABASE_URL="file:./dev.db"

# Senha digitada no painel administrativo (/admin).
PANEL_PASSWORD="SENHA-DEFINIDA-PELO-USUARIO"

# Segredo que assina o token de sessão do admin (mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET="TROQUE-POR-UM-SEGREDO-LONGO-E-ALEATORIO"

# Segredo do proxy assinado do Netlify. Deve ter o MESMO valor da variável
# API_SIGNATURE_TOKEN configurada no painel do Netlify. Obrigatório em produção;
# vazio em desenvolvimento local desliga a verificação.
NETLIFY_PROXY_SECRET=""

# Opcionais
# NODE_ENV="production"
# FRONTEND_URL="https://brco.netlify.app"
# TRUST_PROXY=1
# LOG_LEVEL="info"
